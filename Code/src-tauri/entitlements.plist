<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Tauri uses WKWebView under hardened runtime. The JavaScript engine
         JIT-compiles user-facing UI code, so the webview process needs to
         allocate writable+executable pages. Without these two entitlements
         the app launches but the webview silently fails to render. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
